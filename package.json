{
  "name": "claude-image",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Volumetric cloud renderer foundation layer (raw WebGL2 + GLSL + TypeScript + Vite).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:quality-doc": "node scripts/gen-quality-doc.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "test:headless": "npm run build && node scripts/headless-test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=20"
  }
}
